# Hub private key (docker run --rm ghcr.io/nercone-infra/ruconet:latest ruconet-hub keygen)
RUCONET_PRIVATE_KEY=

# Members (docker compose run --rm ruconet ruconet-hub keygen <name>)
# Names are upper-cased and "-" is replaced with "_" (mail-relay -> MAIL_RELAY).
RUCONET_PEER_GATEWAY_PUBLIC_KEY=
RUCONET_PEER_GATEWAY_PRESHARED_KEY=
RUCONET_PEER_DB_PUBLIC_KEY=
RUCONET_PEER_DB_PRESHARED_KEY=
RUCONET_PEER_MAIL_PUBLIC_KEY=
RUCONET_PEER_MAIL_PRESHARED_KEY=
RUCONET_PEER_MAIL_RELAY_PUBLIC_KEY=
RUCONET_PEER_MAIL_RELAY_PRESHARED_KEY=
RUCONET_PEER_GITEA_PUBLIC_KEY=
RUCONET_PEER_GITEA_PRESHARED_KEY=
RUCONET_PEER_PDS_PUBLIC_KEY=
RUCONET_PEER_PDS_PRESHARED_KEY=
RUCONET_PEER_WEBSITE_PUBLIC_KEY=
RUCONET_PEER_WEBSITE_PRESHARED_KEY=

# Cloudflare API token (Zone:DNS:Edit) for the DNS-01 challenge
CLOUDFLARE_API_TOKEN=

# Let's Encrypt (only used when no account exists yet)
LETSENCRYPT_EMAIL=
